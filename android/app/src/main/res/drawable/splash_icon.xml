<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon — logo scaled to sit inside the system circle mask -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <bitmap
            android:src="@drawable/mport_splash_icon"
            android:gravity="center"
            android:filter="true" />
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06080F</item>
        <item name="android:navigationBarColor">#06080F</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="NormalTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#06080F</item>
        <item name="android:navigationBarColor">#06080F</item>
        <item name="android:windowBackground">#06080F</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
